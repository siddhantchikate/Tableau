      <aliases enabled='yes' />
      <column caption='review' datatype='integer' name='[Calculation_1332661907972102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Review Scores Rating],0)' />
      </column>
      <column caption='Review performace score' datatype='integer' name='[Calculation_1722713660452866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]*[Review Scores Rating]' />
      </column>
      <column caption='propeties by priceing' datatype='string' name='[Calculation_1722713660764163]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;=300 then &quot;luxury&quot; elseif [Price]&gt;=150 then &quot;standerd&quot; else &quot;budget&quot;END' />
      </column>
      <column caption='highly reviewed ' datatype='real' name='[Calculation_1722713661132804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='highly reviewd listings' datatype='string' name='[Calculation_1722713662054405]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Number Of Reviews]&gt;100 then&quot;highly reviewed&quot; else &quot;less reviewed&quot; END' />
      </column>
      <column caption='Avalibilty status' datatype='string' name='[Calculation_1722713662558214]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Host Since]&lt;=TODAY()then &quot;activate host&quot;ELSE&quot;new host&quot;END' />
      </column>
      <column caption='price filter category ' datatype='string' name='[Calculation_1722713664344075]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Price]&gt;[Parameters].[Parameter 1722713663127560]then &quot;above limit&quot; else &quot;below limit&quot;END' />
      </column>
